{
  "framework": "vite",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/YaCasi/alert", "destination": "/alert.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
